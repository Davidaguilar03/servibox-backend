# Caddy obtiene y renueva los certificados de Let's Encrypt solo (puertos 80 y 443 abiertos y
# DNS apuntando al servidor). Los dominios salen de API_DOMAIN y FRONTEND_DOMAIN (.env).

{$API_DOMAIN:api.servibox.co} {
	encode zstd gzip
	reverse_proxy backend:8080 {
		# IP real del cliente: Caddy reemplaza cualquier X-Real-IP que mande el cliente.
		header_up X-Real-IP {remote_host}
		# Una sola cabecera HSTS aunque el backend tambien la envie.
		header_down Strict-Transport-Security "max-age=15552000"
	}
}

{$FRONTEND_DOMAIN:servibox.co} {
	root * /srv/frontend
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Cache-Control "no-cache"
	}
	# Assets con hash: sin fallback SPA, un archivo inexistente da 404. Solo lo que existe se
	# marca immutable, para que un 404 no quede guardado un ano en el navegador.
	handle /assets/* {
		@asset file
		header @asset Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# SPA: toda otra ruta que no sea un archivo existente entrega index.html.
	handle {
		try_files {path} /index.html
		file_server
	}
}
