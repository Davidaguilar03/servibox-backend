# Copiar a .env (cp .env.example .env), llenar y proteger: chmod 600 .env
# Nunca subir .env a Git. Como generar cada secreto: docs/deploy/VPS.md.

# Version de la imagen del backend (commit desplegado). Ver "Actualizar y volver atras".
BACKEND_TAG=latest

# Dominios que sirve Caddy
API_DOMAIN=api.servibox.co
FRONTEND_DOMAIN=servibox.co

# PostgreSQL (el compose arma DB_URL, DB_USERNAME y DB_PASSWORD con estos valores)
POSTGRES_DB=servibox
POSTGRES_USER=servibox
POSTGRES_PASSWORD=

# Claves (cada una aleatoria, de al menos 32 bytes y distinta de las otras)
JWT_SECRET=
PLATFORM_JWT_SECRET=
MAIL_OUTBOX_ENCRYPTION_KEY=

# Frontend
ACTIVATION_BASE_URL=https://servibox.co
CORS_ALLOWED_ORIGINS=https://servibox.co

# Solicitudes de registro: dejar false hasta verificar un correo real
REGISTRATION_REQUESTS_ENABLED=false

# Correo (opcional; sin SMTP_HOST los correos quedan pendientes)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
